\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Worked examples, with $a=0.5$, $\sigma =0.025$, uniform prior on $[0.45,1]$. (a) Example~\ref {ex:1d} with $y/a=0.75$: the bounds are far from the likelihood peak, so the posterior coincides with the normalized likelihood (the dashed curve lies under the solid one). (b) The same with $y/a=0.98$: the bound $z=1$ cuts the likelihood, and the posterior is the truncated Gaussian. (c) Example~\ref {ex:2d}: one measurement of $0.5z_1+0.3z_2$; the posterior is a ridge along the line $a_1z_1+a_2z_2=y$, cut by the box.}}{12}{figure.1}\protected@file@percent }
\newlabel{fig:examples}{{1}{12}{Worked examples, with $a=0.5$, $\sigma =0.025$, uniform prior on $[0.45,1]$. (a) Example~\ref {ex:1d} with $y/a=0.75$: the bounds are far from the likelihood peak, so the posterior coincides with the normalized likelihood (the dashed curve lies under the solid one). (b) The same with $y/a=0.98$: the bound $z=1$ cuts the likelihood, and the posterior is the truncated Gaussian. (c) Example~\ref {ex:2d}: one measurement of $0.5z_1+0.3z_2$; the posterior is a ridge along the line $a_1z_1+a_2z_2=y$, cut by the box}{figure.1}{}}
