\newlabel{tab:gamma_sensitivity}{{R1}{2}{Sensitivity of the proposed method to the hyperparameter $\gamma $ on the validation dataset (2,400 observations with seven stiffness factors each). Metrics as defined in R1.3 and R1.6}{table.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {R1}{\ignorespaces Sensitivity of the performance metrics to the hyperparameter $\gamma $ on the validation dataset (2,400 observations, all stiffness factors): (a)~95\% empirical coverage $C(0.95)$ (left axis) and mean absolute calibration error (MACE, right axis); (b)~root-mean-square error (RMSE) and mean absolute error (MAE) of the posterior mean $\hat  {\mathbf  {z}}$ (left axis) and average log-likelihood (ALL, right axis). The vertical dotted line marks $\gamma =1$.}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:gamma_sensitivity}{{R1}{3}{Sensitivity of the performance metrics to the hyperparameter $\gamma $ on the validation dataset (2,400 observations, all stiffness factors): (a)~95\% empirical coverage $C(0.95)$ (left axis) and mean absolute calibration error (MACE, right axis); (b)~root-mean-square error (RMSE) and mean absolute error (MAE) of the posterior mean $\hat {\z }$ (left axis) and average log-likelihood (ALL, right axis). The vertical dotted line marks $\gamma =1$}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {R2}{\ignorespaces Effect of $\gamma \in \{0.5,0.75,1,1.5,2\}$ on the 1D marginal posteriors $q_\gamma (z_d|\mathbf  {m})$ of benchmark scenarios P1, P4, and P5. Varying $\gamma $ scales the width of the marginal posteriors while keeping their mode aligned with the true stiffness factor $z^*$ (vertical dotted line); near the upper bound $z=1$, wider truncated marginals become more skewed toward lower values, shifting their mean downward.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:gamma_benchmarks_1D}{{R2}{3}{Effect of $\gamma \in \{0.5,0.75,1,1.5,2\}$ on the 1D marginal posteriors $q_\gamma (z_d|\m )$ of benchmark scenarios P1, P4, and P5. Varying $\gamma $ scales the width of the marginal posteriors while keeping their mode aligned with the true stiffness factor $z^*$ (vertical dotted line); near the upper bound $z=1$, wider truncated marginals become more skewed toward lower values, shifting their mean downward}{figure.caption.3}{}}
