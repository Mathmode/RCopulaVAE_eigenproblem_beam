\@writefile{lot}{\contentsline {table}{\numberline {R1}{\ignorespaces Sensitivity of the proposed method to the hyperparameter $\gamma $ on the validation dataset (2,400 observations with seven stiffness factors each). Metrics as defined in R1.3 and R1.6.}}{2}{table.caption.1}\protected@file@percent }
